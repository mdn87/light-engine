# Safe by default. Do not set LAN until the device list is verified.
LIGHT_ENGINE_MODE=simulation
LIGHT_ENGINE_MAX_HZ=3
# Spacing between consecutive UDP commands to one bulb, in milliseconds.
LIGHT_ENGINE_COMMAND_GAP_MS=25
# Power on/off endpoint is refused unless this is 1.
LIGHT_ENGINE_ALLOW_POWER=0
# LIGHT_ENGINE_DEVICES_FILE=/absolute/path/to/devices.json
